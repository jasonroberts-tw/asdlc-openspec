// Deliberately almost empty. Every part of the setup lives in Dockerfile / entrypoint.sh, so this
// file only points at them -- no `features`, no `postCreateCommand`, nothing that has to resolve
// over the network when a container is created. If you are about to add a setup step here, add a
// layer to the Dockerfile instead.
//
// The exceptions are the mounts, the terminal's COLORTERM and your TypeSafe key below, which cannot
// be anywhere else: a bind mount names a path on YOUR machine, COLORTERM your terminal, the key your
// account, and an image is shared by everyone.
{
  "name": "Development container",
  // The repository's root is the build context, so the image can install the toolchain from
  // `mise.toml` and `mise.lock`; `Dockerfile.dockerignore` keeps everything else out of it.
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // The image already runs as this user; naming it keeps the CLI from falling back to root and
  // leaving root-owned files in the clone.
  "remoteUser": "vscode",

  // No host checkout. The CLI bind-mounts the folder it is given unless this is set, and through that
  // mount a container shared the host's `.git` and `.beads/` with it: it unregistered the host's
  // worktrees (asdlc-openspec-486e), corrupted the tracker's database by writing it beside the host
  // (asdlc-openspec-9a2a), and wrote code the host then ran (asdlc-openspec-3901). Empty, it mounts
  // nothing; the container works in a clone of its own, in the workspace volume below, which
  // entrypoint.sh clones at the first start (docs/decisions.md § D-54). The folder given to the CLI
  // then supplies only this file and the build's context, so it may be any clone, the one your
  // sessions use included. The volume is named in `mounts`, not here, because the CLI substitutes
  // `${devcontainerId}` there and not in this property (CLI 0.89.0, tried on 2026-10-06).
  "workspaceMount": "",
  "workspaceFolder": "/workspaces/asdlc-openspec",

  // None of your logins. A session here acts as the agents' GitHub App, and as nobody else
  // (docs/decisions.md § D-51), so this mounts none of your `~/.config/gh`, `~/.ssh`, `~/.claude` or
  // `~/.claude.json`, and passes no `GH_TOKEN` through: each would hand a session your identity, and
  // a writable `~/.claude` a way to run code in your next session on the host, through its hooks.
  // The one credential of yours that comes in is your TypeSafe key, in `remoteEnv` below, and only
  // once you set DEVCONTAINER_TYPESAFE_API_KEY (docs/decisions/asdlc-openspec-llbi.md § Decision).
  //
  // `${localEnv:HOME}${localEnv:USERPROFILE}` is one path, not two: exactly one of the pair is set
  // -- HOME on Linux and macOS, USERPROFILE on Windows -- so the empty one contributes nothing.
  "mounts": [
    // The App's private key, read-only: the directory holding it, which
    // scripts/github-app-token.mjs reads through GITHUB_APP_KEY_DIR below, and nothing else but an
    // optional `langfuse.json`, the keys of the container's own Langfuse project, which
    // entrypoint.sh's `tracing` reads. A directory rather than the file, so a key generated afresh,
    // under a new name, needs no edit here. It must exist, even empty, or Docker refuses to start the
    // container; .devcontainer/README.md says how to give the container the key, and the Langfuse keys.
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.asdlc-agent-j,target=/home/vscode/.github-app,type=bind,readonly",
    // Claude Code's state, in a volume of the container's own, one per clone: your login in the
    // container, its history and its plugins, kept across a rebuild and shared with no host.
    "source=claude-code-${devcontainerId},target=/home/vscode/.claude,type=volume",
    // The container's own clone, one per folder given to the CLI: the only copy of what a session
    // here has not pushed, which `docker volume rm` on it, or a reset of Docker, deletes. Its target
    // is `workspaceFolder`'s, which the CLI substitutes here (CLI 0.89.0, tried on 2026-10-06).
    "source=workspace-${devcontainerId},target=${containerWorkspaceFolder},type=volume"
  ],

  "containerEnv": {
    // mise trusts the clone's `mise.toml`, which a shim, a git hook or the entrypoint reads with no
    // one there to answer a prompt to trust it, and nothing else: a path wider than the workspace
    // folder would trust any other repository's `mise.toml` cloned beside it, and its settings with
    // it. Set on the container rather than in the image, because only the CLI knows the folder's
    // name.
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}",
    // The clone entrypoint.sh makes at the first start and sets up at every start.
    "REPO_WORKSPACE": "${containerWorkspaceFolder}",
    // The clone whose scripts/github-app-token.mjs the image's `gh` and git credential helper run,
    // and the directory the key is mounted at above.
    "GITHUB_APP_WORKSPACE": "${containerWorkspaceFolder}",
    "GITHUB_APP_KEY_DIR": "/home/vscode/.github-app",
    // Claude Code keeps `.claude.json` beside the rest of its state when this is set, so all of it
    // lands in the volume above rather than in the container's home, which a rebuild discards.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  // Your terminal's color support, which `docker exec` does not carry in: it gives a session
  // TERM=xterm and no COLORTERM, which Claude Code reads as 16 colors. COLORTERM comes through as you
  // have it, and empty when you have none. TERM does not: the image has no terminfo for many a
  // terminal's own (xterm-ghostty among them), and `less` and `clear` fail on one it lacks.
  // `remoteEnv`, not `containerEnv`, because it is read at each `devcontainer exec`, from the
  // terminal that runs it.
  //
  // Your TypeSafe key too, for every tool that calls TypeSafe (`tools/lib/typesafe.ts`), from
  // DEVCONTAINER_TYPESAFE_API_KEY in that terminal: a name of the container's own, so that a host
  // holding the key for other work passes nothing until someone sets it. Unset, it arrives empty, and
  // each of those tools skips and says why. Read at each `exec`, so a rotated key needs no rebuild.
  // .devcontainer/README.md § TypeSafe's key says how to set it, and where its value shows.
  "remoteEnv": {
    "COLORTERM": "${localEnv:COLORTERM}",
    "TYPESAFE_API_KEY": "${localEnv:DEVCONTAINER_TYPESAFE_API_KEY}"
  },

  "customizations": {
    "vscode": {
      // Claude Code's extension, for the agent the image installs and every skill here is written
      // for. No ESLint or Prettier extension: no gate this repository wires runs either
      // (`scripts/lint-ratchet.mjs` waits on a linter being chosen) and no config for either is
      // committed, so one would lint and format by its own defaults, which nothing here holds.
      "extensions": ["anthropic.claude-code"]
    }
  },

  // Docker's init as PID 1, which reaps every orphan. Without it the Dockerfile's `sleep` ends up as
  // PID 1, which reaps none, so every process a session kills or leaves behind stays a zombie
  // (asdlc-openspec-29nx). .devcontainer/README.md § PID 1 says how the CLI starts the container.
  "init": true,
  // The CLI's own shell, which it runs in place of the image's ENTRYPOINT, runs that ENTRYPOINT and
  // the CMD only while this is false.
  "overrideCommand": false
}
