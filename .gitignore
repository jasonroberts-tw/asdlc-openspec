# Dependencies. The lockfile is authoritative; `npm ci` restores this directory.
node_modules/

# Worktrees the harness provisions live INSIDE the checkout, at the harness's own location. A
# checkout inside the working tree carries its own .git, which the parent reads as a gitlink and
# would commit as a phantom submodule. This rule is load-bearing. Do not remove it.
.claude/worktrees/

# The briefing a worktree renders for its own session; absent in the primary checkout, where the
# `@.worktree/CONTEXT.md` import at the end of CLAUDE.md is harmless.
.worktree/

# Machine-specific harness permissions. The tracked .claude/settings.json holds plugins and hook
# registrations and nothing else.
.claude/settings.local.json

# The tracker's per-machine state. `bd init` would write these rules itself, into `.beads/.gitignore`
# and here; `bd bootstrap` writes neither, so they live here. The database is Dolt's and syncs over
# its own git ref, never as files; the gate locks sit beside each root they guard, which puts one
# at the checkout root; the backup is a local export. `.beads/config.yaml` stays tracked, and so
# does any formula under `.beads/formulas/`.
.beads/dolt/
.beads/embeddeddolt/
.beads/proxieddb/
.beads/backup/
.beads/.local_version
.beads/.beads-credential-key
.beads/.env
.beads/*.lock
*.gate.lock*

# The hook runner's per-machine override. On a platform where the runner hangs in parallel it is a
# copy of lefthook-windows.yml, and committing it would switch parallel off for everyone else.
lefthook-local.yml

# Drafts passed to tools by file: commit messages, pull-request bodies, tracker notes. At the
# checkout root, because the harness scratchpad can disappear mid-run and .git is a file, not a
# directory, in a linked worktree.
.scratch/

# The local code graph `npm run code-graph` builds with graphify. Never committed: each person
# builds their own, and part of it comes from a language model (docs/decisions.md § D-20).
# Unanchored, so a stray build inside a worktree is ignored as well.
graphify-out/

# The starter kit's bootstrap state. Delete this entry with KIT-CHECKLIST.md once the checklist is
# done.
.kit/

# Vale's styles: `vale sync` downloads what `.vale.ini` names, and every checkout fetches its own.
# Layout is this repository's own style, tracked, and `vale sync` leaves it in place. Never add a
# bare `.vale-styles/`: git re-includes nothing under a directory it excludes, so Layout goes too.
.vale-styles/*
!.vale-styles/Layout/

# macOS Finder's per-directory metadata.
**/.DS_Store
