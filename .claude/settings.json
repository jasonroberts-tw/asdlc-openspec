{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-git.mjs",
            "timeout": 15,
            "statusMessage": "Checking the command against the worktree rules"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block-generated-edit.mjs",
            "timeout": 15,
            "statusMessage": "Checking the target is not generated output"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-workflow-edit.mjs",
            "timeout": 15,
            "statusMessage": "Checking a workflow edit cannot forge the reviewer's status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gate-summary.mjs",
            "timeout": 240,
            "statusMessage": "Running the fast gates"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gate-summary.mjs",
            "timeout": 240,
            "statusMessage": "Running the fast gates over the subagent's work"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/worktree-create.mjs",
            "timeout": 120,
            "statusMessage": "Provisioning the worktree off main with a briefing"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/worktree-remove.mjs",
            "timeout": 60,
            "statusMessage": "Removing the worktree"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "vale@agent-tools": true
  }
}
